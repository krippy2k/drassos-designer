{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@drassos/core": ["../drassos-engine/packages/core/src/index.ts"],
      "@drassos/engine": ["../drassos-engine/packages/engine/src/index.ts"],
      "@drassos/api": ["../drassos-engine/packages/api/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "examples", "vitest.config.ts"]
}
